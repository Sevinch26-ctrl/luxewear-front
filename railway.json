{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "npm install && chmod -R +x node_modules/.bin && npm run build"
  },
  "deploy": {
    "startCommand": "node node_modules/serve/build/main.js -s dist -l $PORT",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
