# DIQQAT: Vite bu qiymatlarni BUILD vaqtida fayllarga to'g'ridan-to'g'ri
# "quyib" qo'yadi (runtime'da emas). Shuning uchun production'ga deploy
# qilishdan oldin pastdagilarni HAQIQIY (https://) manzillarga almashtiring
# VA qayta build/deploy qiling — aks holda eski qiymat (masalan localhost)
# saytga abadiy "quyilgan" holda qolib, backend bilan aloqa ishlamay qoladi.
VITE_API_URL=http://localhost:8000/api/v1
VITE_ADMIN_URL=http://localhost:5174

# Telegram botingizning HAQIQIY username'i (@ belgisisiz, masalan: luxewear_shop_bot).
# @BotFather'da botingizga bergan nomni shu yerga yozing — bot havolalari
# (Footer, Login sahifasi) shu qiymatdan avtomatik hosil bo'ladi.
VITE_TELEGRAM_BOT_USERNAME=LuxeWearr_bot
